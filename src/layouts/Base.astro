---
import '../styles/global.css';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title = t('sitio.titulo'), description = t('sitio.descripcion') } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
