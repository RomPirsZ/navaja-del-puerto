---
import '@fontsource-variable/archivo/wdth.css';
// The latin subset is the one every page uses: preloaded so the name lands in Archivo
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title = t('sitio.titulo'), description = t('sitio.descripcion') } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <!-- Same value as --carbon: the mobile browser bar continues the charcoal top band -->
    <meta name="theme-color" content="#1c1c1c" />
    <meta name="color-scheme" content="only light" />
    <!--
      `motion`: with JS and no reduced-motion, what will be revealed starts hidden
      (global.css) until the motion module takes it. If the module never arrives, CSS shows
      it anyway after 2.5 s: content never depends on JS (constitution I).
      Under the CSP this script needs its hash (public/_headers).
    -->
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { iniciarMovimiento } from '../lib/animations';
      iniciarMovimiento();
    </script>
  </body>
</html>
