---
// Opening hours as a colour chapter of the sleeve. The live state («Abierto hasta las 7»)
// needs the visitor's clock, so the script fills it in; without JS the week is enough.
import { HORARIO } from '../data/horario';
import { t, type Clave } from '../i18n';
import { formatearHora } from '../lib/reservas/tiempo';

// Monday first, as the week is read
const semana = [1, 2, 3, 4, 5, 6, 0].map((dia) => ({
  dia,
  nombre: t(`dia.${dia}` as Clave),
  tramos: (HORARIO[dia] ?? []).map(({ desde, hasta }) =>
    t('horario.tramo', { desde: formatearHora(desde), hasta: formatearHora(hasta) }),
  ),
}));
---

<section id="horario" class="horario" aria-labelledby="horario-titulo" data-revelar-grupo>
  <h2 id="horario-titulo" class="horario-titulo display" data-revelar>{t('horario.titulo')}</h2>
  <p class="horario-estado display" data-estado-apertura hidden></p>

  <div class="horario-cuerpo">
    <div data-revelar>
      <h3>{t('horario.semana')}</h3>
      <dl class="semana">
        {
          semana.map((d) => (
            <div class="semana-dia" data-dia={d.dia}>
              <dt>{d.nombre}</dt>
              <dd class="cifras">{d.tramos.length > 0 ? d.tramos.join(' · ') : t('horario.cerrado')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div data-revelar>
      <h3>{t('horario.dondeTitulo')}</h3>
      <p class="horario-zona">{t('horario.zona')}</p>
      <p class="horario-nota">{t('horario.ficticio')}</p>
    </div>
  </div>
</section>

<script>
  import { estadoApertura, textoApertura } from '../lib/apertura';
  import { ahoraEnPuerto } from '../lib/reservas/tiempo';

  const estado = document.querySelector<HTMLElement>('[data-estado-apertura]');

  function pintar() {
    const ahora = ahoraEnPuerto(new Date());
    if (estado) {
      estado.textContent = textoApertura(estadoApertura(ahora));
      estado.hidden = false;
    }
    for (const fila of document.querySelectorAll<HTMLElement>('.semana-dia')) {
      if (fila.dataset['dia'] === String(ahora.diaSemana)) fila.setAttribute('aria-current', 'date');
      else fila.removeAttribute('aria-current');
    }
  }

  pintar();
  setInterval(pintar, 60_000);
</script>

<style>
  .horario {
    display: grid;
    gap: 1.5rem;
    padding: var(--seccion) var(--margen);
    background: var(--funda);
    color: var(--tinta);
  }

  .horario-titulo {
    margin: 0;
    font-size: var(--text-titulo);
  }

  .horario-estado {
    margin: 0;
    font-size: clamp(3.5rem, 1rem + 10vw, 11rem);
    text-wrap: balance;
  }

  .horario-cuerpo {
    display: grid;
    gap: 2rem;
  }

  .horario h3 {
    margin: 0 0 0.75rem;
    font-size: var(--text-tema);
  }

  .semana {
    margin: 0;
    border-block-start: 2px solid var(--tinta);
  }

  .semana-dia {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-block-end: 2px solid var(--tinta);
  }

  .semana-dia dt {
    font-weight: 700;
    text-transform: capitalize;
  }

  .semana-dia dd {
    margin: 0;
  }

  /* Today, marked by more than colour: the row turns into the black band */
  .semana-dia[aria-current='date'] {
    background: var(--tinta);
    color: var(--papel);
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
  }

  .horario-zona {
    margin: 0;
    font-size: var(--text-tema);
    line-height: 1.3;
    max-width: 30ch;
  }

  .horario-nota {
    margin: 0.75rem 0 0;
    font-size: var(--text-nota);
  }

  @media (width >= 64rem) {
    .horario-cuerpo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--hueco);
    }
  }
</style>
