---
// First viewport (surface contract): the orange sleeve with the name stacked as a monument
// and the portrait slipping between its letters; beside it, side A: the services.
import { SERVICIOS } from '../data/servicios';
import { t, type Clave } from '../i18n';
import Foto from './Foto.astro';
import Navaja from './Navaja.astro';
import Servicios from './Servicios.astro';
---

<div class="portada">
  <div class="funda">
    <h1 class="funda-nombre display">
      <span class="linea linea-navaja">Navaja</span>{' '}
      <span class="linea linea-del">del</span>{' '}
      <span class="linea linea-puerto">Puerto</span>
    </h1>
    <div class="funda-retrato">
      <Foto
        nombre="hero-retrato"
        alt={t('hero.retrato')}
        aspecto="aspect-[4/5]"
        anchos={[320, 480, 640, 900]}
        sizes="(width >= 64rem) 34vw, 60vw"
        prioridad
      />
    </div>
    <div class="funda-muestras" aria-hidden="true">
      {
        SERVICIOS.map((s) => (
          <div class="funda-muestra" data-muestra={s.id}>
            <Foto
              nombre={`servicio-${s.id}`}
              alt={t('servicios.muestra', { servicio: t(`servicio.${s.id}.nombre` as Clave) })}
              aspecto="aspect-square"
              anchos={[320, 480]}
              sizes="22vw"
            />
          </div>
        ))
      }
    </div>
    <p class="funda-catalogo cifras"><Navaja class="funda-navaja" />{t('hero.catalogo')}</p>
  </div>

  <div class="portada-lado" data-revelar-grupo>
    <p class="portada-frase" data-revelar>{t('hero.frase')}</p>
    <Servicios />
    <div class="portada-accion" data-revelar>
      <a class="boton" href="#reservar">{t('nav.reservar')}</a>
      <div class="etiqueta-vinilo" aria-hidden="true">
        <span>Tu turno</span>
        <i></i>
        <span class="cifras">NP-····</span>
      </div>
    </div>
  </div>
</div>

<style>
  .portada {
    display: grid;
    gap: 1.5rem var(--hueco);
    padding: var(--margen);
  }

  /* The sleeve: an orange field whose width sizes the name (container query units) */
  .funda {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    background: var(--rojo);
    color: var(--hueso);
    /* An LP sleeve is square; on wide screens it never grows taller than the viewport */
    aspect-ratio: 1;
    width: 100%;
    padding: 3cqi 4cqi;
  }

  .funda-nombre {
    position: relative;
    display: grid;
    margin: 0;
    font-size: max(3rem, 33.6cqi);
    line-height: 0.8;
  }

  .linea {
    display: block;
    white-space: nowrap;
    perspective: 900px;
  }

  /* Letters split by the motion module turn on their baseline, in a wave */
  .linea :global(span) {
    display: inline-block;
    transform-origin: 50% 85%;
  }

  .linea-navaja {
    position: relative;
    z-index: 1;
  }

  /* «del» smaller and to the right: the portrait fills the gap to its left */
  .linea-del {
    justify-self: end;
    font-size: 0.56em;
    margin-block: 0.06em 0.04em;
  }

  .linea-puerto {
    position: relative;
    z-index: 3;
    font-size: 1.015em;
  }

  /* The cut-out duotone portrait (scripts/retrato-hero.sh) stands in front of the name, as in
     the reference: the head over «Puerto», the shoulders in the sleeve's lower third */
  .funda-retrato {
    position: absolute;
    z-index: 4;
    inset-inline-start: -5cqi;
    inset-block-end: 0;
    width: 62cqi;
  }

  /* Side A as cover art: hovering a track wipes its photo into the sleeve's free corner,
     multiplied into the orange like the portrait (only with a mouse, on wide screens) */
  .funda-muestras {
    display: none;
  }

  @media (width >= 64rem) and (hover: hover) {
    .funda-muestras {
      display: block;
      position: absolute;
      z-index: 3;
      inset-inline-end: 4cqi;
      inset-block-end: 7cqi;
      width: 30cqi;
      aspect-ratio: 1;
      mix-blend-mode: multiply;
    }

    .funda-muestra {
      position: absolute;
      inset: 0;
      clip-path: inset(100% 0 0 0);
      /* Leaving: a little quicker than arriving (open/close asymmetry) */
      transition: clip-path 350ms var(--curva);
    }

    .portada:has([data-servicio='corte'] :is(:hover, :focus-visible)) [data-muestra='corte'],
    .portada:has([data-servicio='corte-barba'] :is(:hover, :focus-visible)) [data-muestra='corte-barba'],
    .portada:has([data-servicio='barba'] :is(:hover, :focus-visible)) [data-muestra='barba'],
    .portada:has([data-servicio='afeitado'] :is(:hover, :focus-visible)) [data-muestra='afeitado'],
    .portada:has([data-servicio='infantil'] :is(:hover, :focus-visible)) [data-muestra='infantil'] {
      clip-path: inset(0);
      transition-duration: 400ms;
    }

    .portada:has(.pista :is(:hover, :focus-visible)) .funda-catalogo {
      opacity: 0;
    }
  }

  .funda :global(.funda-navaja) {
    width: 3.5rem;
    margin-inline-end: 0.5rem;
    vertical-align: middle;
  }

  .funda :global(.funda-navaja .navaja-grabado) {
    stroke: var(--rojo);
  }

  /* Phones: the sleeve fills the first screen under the notice and the header, so the name
     and the portrait own it; the portrait sits under «Puerto» and only bites its foot */
  @media (width < 48rem) {
    .funda {
      aspect-ratio: auto;
      min-block-size: calc(100svh - 7.75rem - 2 * var(--margen));
    }

    /* The portrait box runs from the foot of «Puerto» to the bottom edge; the photo covers
       it from the top, so the hair rides over the lower part of the letters as on desktop */
    .funda-retrato {
      inset: 27cqi -15cqi 0 -25cqi;
      width: auto;
    }

    .funda-retrato :global(img) {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: 50% top;
    }
  }

  /* Decorative catalogue line: only where it clears the portrait */
  .funda-catalogo {
    transition: opacity 150ms var(--curva);
    display: none;
    position: absolute;
    inset-inline-end: 4cqi;
    inset-block-end: 3cqi;
    margin: 0;
    font-weight: 700;
    font-size: var(--text-nota);
  }

  .portada-lado {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .portada-frase {
    margin: 0;
    font-size: var(--text-tema);
    line-height: 1.3;
    max-width: 30ch;
    text-wrap: pretty;
  }

  .portada-accion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* The record label: the page's only circle, and the booking ticket to come */
  .etiqueta-vinilo {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--carbon);
    color: var(--hueso);
    font-weight: 700;
    font-size: var(--text-nota);
    flex-shrink: 0;
  }

  .etiqueta-vinilo i {
    width: 0.85rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hueso);
  }

  @media (width >= 48rem) {
    .funda-catalogo {
      display: block;
    }
  }

  @media (width >= 64rem) {
    /* The square sleeve is as wide as the viewport is tall, at most 58 % of the row */
    .portada {
      grid-template-columns: min(58%, calc(100svh - 4rem - 2 * var(--margen))) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
