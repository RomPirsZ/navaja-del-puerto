---
// First viewport (user's redesign of 2026-11-21): a charcoal hero, full bleed at every width.
// The headline, the line that says what this is and the main action sit top left; Leo, cut
// out of his studio photo, stands in front of «NAVAJA», which spans the whole width and fades
// into a red glow; a strip at the foot carries three real services and the live opening state.
import { t } from '../i18n';
import Foto from './Foto.astro';
import Navaja from './Navaja.astro';
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero-fondo" aria-hidden="true">
    <Navaja class="hero-navaja" />
  </div>

  <div class="hero-texto">
    <h1 id="hero-titulo" class="hero-titulo display">
      <span>{t('hero.tituloLinea1')}</span>{' '}
      <span>{t('hero.tituloLinea2')}</span>
    </h1>
    <p class="hero-frase">{t('hero.frase')}</p>
    <a class="boton" href="#reservar">{t('nav.reservar')}</a>
  </div>

  <div class="hero-escena">
    <p class="hero-palabra" aria-hidden="true"><span class="hero-palabra-texto">{t('hero.palabra')}</span></p>
    <div class="hero-retrato">
      <Foto
        nombre="hero-retrato"
        alt={t('hero.retrato')}
        aspecto="aspect-[800/993]"
        anchos={[360, 540, 720, 1000]}
        sizes="(width >= 64rem) 44vw, (width >= 48rem) 60vw, 82vw"
        prioridad
      />
    </div>
  </div>

  <div class="hero-franja">
    <ul class="hero-rasgos" aria-label={t('hero.rasgos')}>
      <li>
        <!-- Scissors, open -->
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="6" cy="6.5" r="2.75" />
          <circle cx="6" cy="17.5" r="2.75" />
          <path d="M8.2 8.2 20 18.5M8.2 15.8 20 5.5" />
        </svg>
        {t('hero.rasgo.corte')}
      </li>
      <li>
        <!-- Shaving brush: knot, ferrule and handle -->
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8.5 12.5C6.5 9 7.5 3.5 12 3.5s5.5 5.5 3.5 9z" />
          <path d="M8 12.5h8M9.5 12.5l.5 3h4l.5-3M10 15.5v5h4v-5" />
        </svg>
        {t('hero.rasgo.afeitado')}
      </li>
      <li>
        <!-- Comb: spine and teeth -->
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 7.5h18v3.5H3z" />
          <path d="M5 11v6M8.5 11v6M12 11v6M15.5 11v6M19 11v6" />
        </svg>
        {t('hero.rasgo.barba')}
      </li>
    </ul>
    <div class="hero-estado">
      <p class="hero-estado-texto" data-estado-apertura hidden></p>
      <p class="hero-estado-nota">{t('hero.horaPuerto')}</p>
    </div>
  </div>
</section>

<style>
  /* The hero is its own container: «NAVAJA» and the glow are measured against its width */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(16rem, 1fr) auto;
    width: 100%;
    /* The first screen under the notice (two lines on phones) and the 4rem header */
    min-block-size: calc(100svh - 7rem);
    background:
      radial-gradient(70% 55% at 56% 100%, color-mix(in oklab, var(--rojo) 78%, transparent), transparent 72%),
      radial-gradient(40% 30% at 56% 100%, color-mix(in oklab, var(--rojo) 55%, transparent), transparent),
      var(--carbon);
    color: var(--hueso);
  }

  /* The razor of this view, large and faint, where the reference has its comb */
  .hero-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero :global(.hero-navaja) {
    position: absolute;
    inset-block-start: 4%;
    inset-inline-end: -30cqi;
    width: 72cqi;
    rotate: -20deg;
    color: color-mix(in oklab, var(--hueso) 6%, transparent);
  }

  .hero :global(.hero-navaja .navaja-grabado) {
    stroke: var(--carbon);
  }

  .hero-texto {
    position: relative;
    z-index: 3;
    grid-row: 1;
    grid-column: 1;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.75rem, 1rem + 3vh, 4.5rem) var(--margen) 0;
  }

  .hero-titulo {
    margin: 0;
    font-size: clamp(2.5rem, 1.4rem + 3.2vw, 4.5rem);
    line-height: 0.86;
    text-wrap: balance;
  }

  .hero-titulo span {
    display: block;
  }

  .hero-frase {
    margin: 0;
    max-width: 34ch;
    font-size: var(--text-cuerpo);
    color: var(--hueso-suave);
    text-wrap: pretty;
  }

  /* On the charcoal, hovering the red button turns it bone (charcoal-on-charcoal would vanish) */
  .hero .boton:hover {
    background: var(--hueso);
    color: var(--carbon);
  }

  /* The stage: the word and Leo. On phones it is the row between the text and the strip; from
     tablets up it spans the whole hero, so Leo rises beside the headline */
  .hero-escena {
    position: relative;
    z-index: 1;
    grid-row: 2;
    grid-column: 1;
  }

  /* «NAVAJA» edge to edge in Archivo's widest cut (5.35 em wide), fading into the glow
     (mask-image, so the letters themselves fade and the split letters keep it) */
  .hero-palabra {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    inset-block-end: 0;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    text-transform: uppercase;
    font-size: calc((100cqi - 2 * var(--margen)) / 5.35);
    line-height: 0.74;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--hueso);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 10%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 10%, transparent 98%);
  }

  /* Letters split by the motion module turn on their baseline, in a wave */
  .hero-palabra-texto {
    display: inline-block;
    perspective: 900px;
  }

  .hero-palabra-texto :global(span) {
    display: inline-block;
    transform-origin: 50% 85%;
  }

  /* Leo stands in front of the word. His photo is cut at the hands and the hem: the mask lets
     both edges dissolve into the dark instead of ending on a hard line. On phones he rises
     a little into the text row, to the right of the button */
  .hero-retrato {
    position: absolute;
    z-index: 2;
    inset-block-end: 0;
    inset-inline-start: 58%;
    translate: -50% 0;
    block-size: calc(100% + 4.5rem);
    aspect-ratio: 800 / 993;
    -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 99%), linear-gradient(to left, transparent, black 14%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, black 72%, transparent 99%), linear-gradient(to left, transparent, black 14%);
    mask-composite: intersect;
  }

  .hero-retrato :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
  }

  .hero-franja {
    position: relative;
    z-index: 3;
    grid-row: 3;
    grid-column: 1;
    display: grid;
    gap: 1rem;
    padding: 1rem var(--margen) 1.25rem;
    font-size: var(--text-nota);
    font-weight: 600;
  }

  .hero-rasgos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-rasgos li {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.4rem;
    line-height: 1.25;
  }

  .hero-rasgos svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  /* Without the script there is no live state: the whole block stays out */
  .hero-estado:has([data-estado-apertura][hidden]) {
    display: none;
  }

  .hero-estado p {
    margin: 0;
  }

  .hero-estado-texto {
    font-size: var(--text-tema);
    font-weight: 800;
    line-height: 1.2;
  }

  /* Bone, not the softer bone: over the red glow the soft one drops to about 3.5:1 */
  .hero-estado-nota {
    font-weight: 500;
  }

  @media (forced-colors: active) {
    .hero-palabra {
      color: GrayText;
    }
  }

  /* Tablet and up: the strip runs in one line, services left and the live state right */
  @media (width >= 48rem) {
    .hero {
      min-block-size: max(36rem, calc(100svh - 6rem));
    }

    .hero-escena {
      grid-row: 1 / -1;
    }

    .hero-palabra {
      inset-block-end: 4.5rem;
    }

    .hero-retrato {
      block-size: min(90%, 52rem);
      inset-inline-start: 60%;
    }

    .hero-texto {
      max-width: min(40rem, 50cqi);
    }

    .hero-franja {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: end;
    }

    .hero-rasgos {
      display: flex;
      gap: 1.75rem;
    }

    .hero-rasgos li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .hero-estado {
      text-align: end;
    }
  }

  @media (width >= 64rem) {
    .hero-retrato {
      inset-inline-start: 57%;
      block-size: min(94%, 60rem);
    }
  }
</style>
