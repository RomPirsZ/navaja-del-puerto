---
/**
 * A photo from src/assets/fotos/ (AI-generated by the user, docs imagenes.md). Until the
 * file exists, a flat placeholder with the same aspect ratio keeps the layout honest.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { t } from '../i18n';

interface Props {
  nombre: string;
  alt: string;
  /** Tailwind aspect class, e.g. aspect-[4/5]: the slot keeps it with or without the file */
  aspecto: string;
  clase?: string;
  anchos: number[];
  sizes: string;
  prioridad?: boolean;
}

const { nombre, alt, aspecto, clase = '', anchos, sizes, prioridad = false } = Astro.props;
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,webp}', { eager: true });
const archivo = Object.entries(archivos).find(([ruta]) => ruta.split('/').pop()?.replace(/\.\w+$/, '') === nombre)?.[1];
---

{
  archivo ? (
    <Picture
      src={archivo.default}
      alt={alt}
      widths={anchos}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      class:list={['foto block h-auto w-full object-cover', aspecto, clase]}
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : 'auto'}
    />
  ) : (
    <div role="img" aria-label={alt} class:list={['foto foto-pendiente', aspecto, clase]} data-pendiente={nombre}>
      <span aria-hidden="true">{t('foto.pendiente')}</span>
    </div>
  )
}

<style>
  .foto-pendiente {
    display: grid;
    place-items: end start;
    padding: 0.75rem;
    background: var(--carbon-alto);
    color: var(--hueso-suave);
    font-size: var(--text-nota);
  }
</style>
