---
// One navigation tree at every width (modern-web-guidance «navbar»): a native popover on
// narrow screens, which works without JavaScript, and the same list inline on wide ones.
import { t } from '../i18n';

const enlaces = [
  { href: '#servicios', texto: t('nav.servicios') },
  { href: '#barberos', texto: t('nav.barberos') },
  { href: '#horario', texto: t('nav.horario') },
];
---

<header class="cabecera">
  <div class="cabecera-fila">
    <a class="cabecera-marca display" href="#" aria-label={t('nav.inicio')}>{t('marca.nombre')}</a>
    <nav class="cabecera-nav" aria-label={t('nav.etiqueta')}>
      <button class="cabecera-menu" type="button" popovertarget="menu-principal" aria-controls="menu-principal">
        {t('nav.menu')}
      </button>
      <ul id="menu-principal" class="cabecera-lista" popover="auto">
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
        <li class="solo-menu"><a class="cabecera-lista-accion" href="#reservar">{t('nav.reservar')}</a></li>
        <li class="solo-menu">
          <button class="cabecera-cerrar" type="button" popovertarget="menu-principal" popovertargetaction="hide">
            {t('nav.cerrar')}
          </button>
        </li>
      </ul>
    </nav>
    <a class="cabecera-accion" href="#reservar">{t('nav.reservarCorto')}<span class="solo-ancho">&nbsp;{t('nav.reservarResto')}</span></a>
  </div>
</header>

<script>
  // A link inside the popover closes it, so the page under it is visible again
  const lista = document.getElementById('menu-principal');
  lista?.addEventListener('click', (evento) => {
    if (evento.target instanceof HTMLAnchorElement && lista.matches(':popover-open')) lista.hidePopover();
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--carbon);
    color: var(--hueso);
  }

  .cabecera-fila {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding-inline: var(--margen);
  }

  .cabecera-marca {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    white-space: nowrap;
    line-height: 1;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .cabecera-menu,
  .cabecera-lista a,
  .cabecera-accion {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    text-decoration: none;
  }

  .cabecera-menu {
    padding-inline: 0.75rem;
    color: inherit;
    background: transparent;
    border: 2px solid var(--hueso-suave);
    cursor: pointer;
    anchor-name: --menu-principal;
  }

  .cabecera-accion {
    padding-inline: 0.875rem;
    white-space: nowrap;
    background: var(--rojo);
    color: var(--hueso);
  }

  /* Narrow: the list is a popover under the header; the page behind blurs (as in Swap) */
  .cabecera-lista {
    position: fixed;
    inset: auto;
    inset-block-start: 4.5rem;
    inset-block-start: anchor(--menu-principal bottom);
    inset-inline: var(--margen);
    /* The UA gives popovers fit-content: here the menu spans the margins */
    width: auto;
    margin: 0.5rem 0 0;
    padding: 0.5rem 1.25rem;
    list-style: none;
    background: var(--carbon);
    color: var(--hueso);
    border: 0;
  }

  .cabecera-lista a {
    width: 100%;
    font-size: var(--text-tema);
    min-height: 3.25rem;
  }

  .cabecera-lista::backdrop {
    background: color-mix(in oklab, var(--carbon) 35%, transparent);
    backdrop-filter: blur(10px);
  }

  /* Narrow layout only: on wide screens the list is inline and never a popover */
  @media (prefers-reduced-motion: no-preference) and (width < 48rem) {
    .cabecera-lista {
      /* Closing gets out of the way faster than opening (dropdown: 250 ms in, 150 ms out) */
      transition:
        opacity 150ms var(--curva),
        translate 150ms var(--curva),
        display 150ms,
        overlay 150ms;
      transition-behavior: allow-discrete;
    }

    .cabecera-lista:popover-open {
      transition-duration: 250ms;
    }

    .cabecera-lista:not(:popover-open) {
      opacity: 0;
      translate: 0 -0.5rem;
    }

    @starting-style {
      .cabecera-lista:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }

  .cabecera-accion:hover,
  .cabecera-lista a:hover {
    text-decoration: underline;
  }

  /* Inside the narrow panel: the booking action and a visible way out (the page behind,
     header included, is blurred) */
  .cabecera-lista .cabecera-lista-accion {
    margin-block: 0.5rem;
    padding-inline: 1rem;
    justify-content: center;
    background: var(--rojo);
    color: var(--hueso);
  }

  .cabecera-cerrar {
    width: 100%;
    min-height: 3rem;
    margin-block-end: 0.5rem;
    font: inherit;
    font-weight: 700;
    color: var(--hueso);
    background: transparent;
    border: 2px solid var(--hueso-suave);
    cursor: pointer;
  }

  .solo-ancho {
    display: none;
  }

  /* Wide: the same list, inline and centred between the name and the action, as in the
     hero reference; the menu button goes away */
  @media (width >= 48rem) {
    .cabecera-fila {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .cabecera-accion {
      justify-self: end;
    }

    .solo-ancho {
      display: inline;
    }

    .solo-menu {
      display: none;
    }

    .cabecera-menu {
      display: none;
    }

    .cabecera-lista {
      position: static;
      display: flex;
      gap: 1.75rem;
      padding: 0;
      margin: 0;
      background: transparent;
    }

    .cabecera-lista a {
      font-size: var(--text-cuerpo);
      min-height: 2.75rem;
    }

    .cabecera-lista::backdrop {
      display: none;
    }
  }
</style>
