---
// The services as a record's tracklist (A1–A5), with duration and sample price; since
// 2026-11-21 the heading is just «Servicios», without «Lado A» (user's request). A row
// leads to the booking with that service chosen (script below; without it, to #reservar).
// Its own section under the hero since the redesign; with a mouse on wide screens, the photo
// of the track under the pointer wipes into the panel beside the list.
import { SERVICIOS } from '../data/servicios';
import { t, type Clave } from '../i18n';
import Foto from './Foto.astro';
---

<section id="servicios" class="servicios" aria-labelledby="servicios-titulo">
  <div class="servicios-lista" data-revelar-grupo>
    <h2 id="servicios-titulo" class="servicios-titulo display" data-revelar>{t('servicios.titulo')}</h2>
    <ol class="pistas">
      {
        SERVICIOS.map((s, i) => {
          const nombre = t(`servicio.${s.id}.nombre` as Clave);
          return (
            <li class="pista" data-servicio={s.id} data-revelar>
              <span class="pista-numero cifras" aria-hidden="true">{t('servicios.pista', { n: String(i + 1) })}</span>
              <span class="pista-texto">
                <a
                  class="pista-nombre"
                  href="#reservar"
                  data-preseleccionar-servicio={s.id}
                  aria-label={t('servicios.reservarServicio', { servicio: nombre })}
                  aria-describedby={`pista-${s.id}`}
                >
                  {nombre}
                </a>
                <span class="pista-descripcion">{t(`servicio.${s.id}.descripcion` as Clave)}</span>
              </span>
              <span class="pista-datos cifras" id={`pista-${s.id}`}>
                <span class="pista-duracion">{t('servicios.duracion', { min: String(s.duracion) })}</span>{' '}
                <span class="pista-precio">{t('servicios.precio', { monto: String(s.precio) })}</span>
                <span class="pista-reservar" aria-hidden="true">{t('servicios.reservar')} →</span>
              </span>
            </li>
          );
        })
      }
    </ol>
    <p class="servicios-nota">{t('servicios.nota')}</p>
  </div>
  <div class="servicios-muestras" aria-hidden="true">
    {
      SERVICIOS.map((s) => (
        <div class="servicios-muestra" data-muestra={s.id}>
          <Foto
            nombre={`servicio-${s.id}`}
            alt={t('servicios.muestra', { servicio: t(`servicio.${s.id}.nombre` as Clave) })}
            aspecto="aspect-square"
            anchos={[400, 600, 800]}
            sizes="36vw"
          />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { preseleccionar } from '../lib/preseleccion';

  for (const enlace of document.querySelectorAll<HTMLAnchorElement>('[data-preseleccionar-servicio]')) {
    enlace.addEventListener('click', () => preseleccionar({ servicioId: enlace.dataset['preseleccionarServicio'] ?? '' }));
  }
</script>

<style>
  .servicios {
    display: grid;
    gap: var(--hueco);
    padding: var(--seccion) var(--margen) 0;
  }

  .servicios-lista {
    max-width: 60rem;
  }

  .servicios-muestras {
    display: none;
  }

  /* Wide screens with a mouse: the photo panel beside the list, printed onto the bone ground.
     The first track's photo waits there; a hovered or focused track wipes its own in */
  @media (width >= 64rem) and (hover: hover) {
    .servicios {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }

    .servicios-muestras {
      display: block;
      position: sticky;
      inset-block-start: 6rem;
      aspect-ratio: 1;
      mix-blend-mode: multiply;
    }

    .servicios-muestra {
      position: absolute;
      inset: 0;
      clip-path: inset(100% 0 0 0);
      /* Leaving: a little quicker than arriving (open/close asymmetry) */
      transition: clip-path 350ms var(--curva);
    }

    .servicios-muestra:first-child,
    .servicios:has([data-servicio='corte'] :is(:hover, :focus-visible)) [data-muestra='corte'],
    .servicios:has([data-servicio='corte-barba'] :is(:hover, :focus-visible)) [data-muestra='corte-barba'],
    .servicios:has([data-servicio='barba'] :is(:hover, :focus-visible)) [data-muestra='barba'],
    .servicios:has([data-servicio='afeitado'] :is(:hover, :focus-visible)) [data-muestra='afeitado'],
    .servicios:has([data-servicio='infantil'] :is(:hover, :focus-visible)) [data-muestra='infantil'] {
      clip-path: inset(0);
      transition-duration: 400ms;
    }

    /* Another track under the pointer: the waiting photo steps aside */
    .servicios:has(.pista:not([data-servicio='corte']) :is(:hover, :focus-visible)) .servicios-muestra:first-child {
      clip-path: inset(100% 0 0 0);
      transition-duration: 350ms;
    }
  }

  /* «Servicios» at the size «Lado A» had (user's request, 2026-11-21) */
  .servicios-titulo {
    margin: 0 0 0.75rem;
    font-size: var(--text-titulo);
  }

  .pistas {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 2px solid var(--carbon);
  }

  /* The whole row is the link: the name's ::after stretches over it */
  .pista {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0.5rem;
    border-block-end: 2px solid var(--carbon);
  }

  .pista-nombre::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pista-nombre:focus-visible {
    outline: none;
  }

  .pista:has(.pista-nombre:focus-visible) {
    outline: 3px solid var(--carbon);
    outline-offset: 2px;
  }

  .pista-numero {
    font-weight: 700;
  }

  .pista-texto {
    display: grid;
    justify-items: start;
  }

  .pista-nombre {
    font-size: var(--text-tema);
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
    text-decoration: none;
  }

  .pista-descripcion {
    color: var(--carbon-suave);
    line-height: 1.35;
  }

  .pista-datos {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-weight: 700;
    position: relative;
  }

  .pista-duracion {
    font-weight: 400;
  }

  .pista-precio {
    font-size: var(--text-tema);
    min-width: 2.5ch;
    text-align: end;
  }

  /* «Reservar →» wipes in over duration and price on hover or focus (clip-path) */
  .pista-reservar {
    position: absolute;
    inset: -0.15rem -0.5rem;
    display: grid;
    place-items: center end;
    padding-inline: 0.6rem;
    background: var(--rojo);
    color: var(--hueso);
    white-space: nowrap;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 250ms var(--curva);
  }

  .pista {
    transition:
      background-color 200ms var(--curva),
      color 200ms var(--curva);
  }

  .pista:has(.pista-nombre:hover),
  .pista:has(.pista-nombre:focus-visible) {
    background: var(--carbon);
    color: var(--hueso);
  }

  .pista:has(.pista-nombre:hover) .pista-descripcion,
  .pista:has(.pista-nombre:focus-visible) .pista-descripcion {
    color: var(--hueso-suave);
  }

  .pista:has(.pista-nombre:hover) .pista-reservar,
  .pista:has(.pista-nombre:focus-visible) .pista-reservar {
    clip-path: inset(0);
  }

  .servicios-nota {
    margin: 0.75rem 0 0;
    font-size: var(--text-nota);
    color: var(--carbon-suave);
  }
</style>
