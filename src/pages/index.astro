---
import Base from '../layouts/Base.astro';
import Reserva from '../components/reserva/Reserva.tsx';
import Navaja from '../components/Navaja.astro';
import { t } from '../i18n';
---

<Base>
  <main>
    <h1 class="display text-monumento">{t('marca.nombre')}</h1>
    <Navaja class="w-60" />
    <section id="reservar" aria-labelledby="reservar-titulo">
      <h2 id="reservar-titulo">{t('reserva.titulo')}</h2>
      <Reserva client:visible />
    </section>
  </main>
</Base>
